{
  "github_token": {
    "description": "GitHub Token（可选）",
    "type": "string",
    "default": "",
    "hint": "不填写也可以订阅公开仓库；填写后可提高 GitHub API 限流额度。"
  },
  "default_intervals": {
    "description": "全局默认轮询间隔",
    "type": "object",
    "items": {
      "star_minutes": {
        "description": "Star 检查间隔（分钟）",
        "type": "int",
        "default": 1
      },
      "release_minutes": {
        "description": "Release 检查间隔（分钟）",
        "type": "int",
        "default": 5
      },
      "issue_minutes": {
        "description": "Issue 检查间隔（分钟）",
        "type": "int",
        "default": 2
      },
      "pr_minutes": {
        "description": "PR 检查间隔（分钟）",
        "type": "int",
        "default": 2
      },
      "min_interval_seconds": {
        "description": "最小轮询间隔（秒）",
        "type": "int",
        "default": 60
      }
    }
  },
  "message_limits": {
    "description": "消息长度和发送节奏限制",
    "type": "object",
    "items": {
      "issue_body_summary_chars": {
        "description": "Issue 内容摘要最大字符数",
        "type": "int",
        "default": 300
      },
      "pr_body_summary_chars": {
        "description": "PR 内容摘要最大字符数",
        "type": "int",
        "default": 300
      },
      "release_notes_max_chars": {
        "description": "Release Note 最大字符数",
        "type": "int",
        "default": 1500
      },
      "max_items_per_event_cycle": {
        "description": "每类事件每轮最多展示条数",
        "type": "int",
        "default": 5
      },
      "message_send_delay_seconds": {
        "description": "逐条发送消息的间隔秒数",
        "type": "int",
        "default": 1
      }
    }
  },
  "github_to_qq": {
    "description": "GitHub 用户名到 QQ UID 的映射",
    "type": "template_list",
    "default": [],
    "hint": "用于 PR 合并提醒时 @ PR 作者。每条映射填写一个 GitHub 用户名和 QQ UID。",
    "templates": {
      "mapping": {
        "name": "用户映射",
        "display_item": "github_login",
        "items": {
          "github_login": {
            "description": "GitHub 用户名",
            "type": "string",
            "default": "",
            "hint": "匹配不区分大小写，例如 JunieXD。"
          },
          "qq_uid": {
            "description": "QQ UID",
            "type": "string",
            "default": "",
            "hint": "PR 合并提醒时会 @ 这个 QQ 用户。"
          }
        }
      }
    }
  },
  "global_templates": {
    "description": "全局默认消息模板",
    "type": "object",
    "items": {
      "star": {
        "description": "Star 提醒模板",
        "type": "text",
        "default": "{repo} 新增 {new_star_count} 个 Star\n当前总 Star：{star_count}\n用户：{star_users}"
      },
      "release": {
        "description": "Release 提醒模板",
        "type": "text",
        "default": "{repo} 发布了 {tag_name}\n{release_name}\n{release_url}\n\n{release_notes}"
      },
      "issue": {
        "description": "Issue 提醒模板",
        "type": "text",
        "default": "{repo} 新 Issue #{number}: {title}\n作者：{author}\n时间：{created_at}\n{body_summary}\n{url}"
      },
      "pr_opened": {
        "description": "新 PR 提醒模板",
        "type": "text",
        "default": "{repo} 新 PR #{number}: {title}\n作者：{author}\n时间：{created_at}\n{body_summary}\n{url}"
      },
      "pr_merged": {
        "description": "PR 合并提醒模板",
        "type": "text",
        "default": "{mention}{repo} PR 已合并 #{number}: {title}\n作者：{author}\n合并者：{merged_by}\n时间：{merged_at}\n{url}"
      }
    }
  },
  "subscriptions": {
    "description": "GitHub 仓库订阅列表",
    "type": "template_list",
    "default": [],
    "hint": "命令添加的订阅也会写入这里。target_umo 形如 aiocqhttp:GroupMessage:123456789，repo 形如 JunieXD/AutoEmailSender。",
    "templates": {
      "subscription": {
        "name": "仓库订阅",
        "display_item": "repo",
        "items": {
          "target_umo": {
            "description": "订阅目标会话 ID",
            "type": "string",
            "default": "",
            "hint": "可使用 /sid 获取当前会话的 target_umo；通过命令添加订阅时会自动写入。"
          },
          "target_name": {
            "description": "订阅目标名称",
            "type": "string",
            "default": ""
          },
          "repo": {
            "description": "GitHub 仓库",
            "type": "string",
            "default": "",
            "hint": "填写 owner/repo 或 GitHub 仓库链接，例如 JunieXD/AutoEmailSender 或 https://github.com/owner/repo。"
          },
          "enabled": {
            "description": "启用此订阅",
            "type": "bool",
            "default": true
          },
          "events": {
            "description": "事件开关",
            "type": "object",
            "items": {
              "star": {
                "description": "Star 事件",
                "type": "bool",
                "default": false
              },
              "release": {
                "description": "Release 事件",
                "type": "bool",
                "default": true
              },
              "issue": {
                "description": "Issue 事件",
                "type": "bool",
                "default": true
              },
              "pr": {
                "description": "PR 事件",
                "type": "bool",
                "default": true
              }
            }
          },
          "intervals": {
            "description": "此订阅的轮询间隔",
            "type": "object",
            "items": {
              "star_minutes": {
                "description": "Star 检查间隔（分钟）",
                "type": "int",
                "default": 1
              },
              "release_minutes": {
                "description": "Release 检查间隔（分钟）",
                "type": "int",
                "default": 5
              },
              "issue_minutes": {
                "description": "Issue 检查间隔（分钟）",
                "type": "int",
                "default": 2
              },
              "pr_minutes": {
                "description": "PR 检查间隔（分钟）",
                "type": "int",
                "default": 2
              }
            }
          },
          "template_overrides": {
            "description": "此订阅的消息模板覆盖",
            "type": "object",
            "items": {
              "star": {
                "description": "Star 提醒模板覆盖",
                "type": "text",
                "default": "",
                "hint": "留空使用全局模板。"
              },
              "release": {
                "description": "Release 提醒模板覆盖",
                "type": "text",
                "default": "",
                "hint": "留空使用全局模板。"
              },
              "issue": {
                "description": "Issue 提醒模板覆盖",
                "type": "text",
                "default": "",
                "hint": "留空使用全局模板。"
              },
              "pr_opened": {
                "description": "新 PR 提醒模板覆盖",
                "type": "text",
                "default": "",
                "hint": "留空使用全局模板。"
              },
              "pr_merged": {
                "description": "PR 合并提醒模板覆盖",
                "type": "text",
                "default": "",
                "hint": "留空使用全局模板。"
              }
            }
          }
        }
      }
    }
  }
}
